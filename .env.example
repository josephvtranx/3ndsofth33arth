# Create an API key at https://resend.com/api-keys and verify the sender domain.
RESEND_API_KEY=re_replace_me
BOOKING_FROM_EMAIL=3ndsofth33arth booking <bookings@your-domain.com>
BOOKING_TO_EMAIL=3ndsofth33arth@gmail.com

# Instagram API with Instagram Login. Server-only; never prefix these with NEXT_PUBLIC_.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Private Vercel Blob store, connected to production only. Never use a public store.
BLOB_READ_WRITE_TOKEN=
# Random server-only secret protecting the Vercel cron endpoint.
CRON_SECRET=

# Required before deploying form protection to Production (fails closed if missing).
# Public widget key only; the other values below are server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.3ndsofth33arth.com,3ndsofth33arth.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a separate random secret (32+ bytes) for hashing rate-limit keys.
FORM_RATE_LIMIT_SECRET=
# Enable for local/preview testing only; Vercel Production always enforces checks.
SPAM_PROTECTION_ENABLED=false

# Private map dashboard. PostgreSQL URL must use your provider's TLS settings.
WAITLIST_DATABASE_URL=
# Enable only after running pnpm waitlist:migrate against the database.
WAITLIST_STORAGE_ENABLED=false
# Set locally with pnpm waitlist:set-pin; never store the plaintext PIN.
WAITLIST_ADMIN_PIN_HASH=
# Separate read-capable Resend key for local import scripts only; never NEXT_PUBLIC_.
RESEND_IMPORT_API_KEY=
# Optional legacy geocoding script only. The form uses the seeded GeoNames catalog.
WAITLIST_GEOCODING_URL=
WAITLIST_GEOCODING_KEY=
